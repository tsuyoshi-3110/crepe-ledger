# ここには鍵を書かない。実際の値は .env.local（コミットされない）に入れる

# Firebase（クレープ帳簿の専用プロジェクト）。空のままだと「お試しの形」（ログインなし・この端末にだけ保存）で動く
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# 帳簿の置き場所 shops/{これ}
NEXT_PUBLIC_SHOP_ID=main

# サーバー側（ログインの確認）。サービスアカウントの JSON を1行で
FIREBASE_SERVICE_ACCOUNT_JSON=

# レシート読み取りの AI（サーバーにだけ置く）
OPENAI_API_KEY=
